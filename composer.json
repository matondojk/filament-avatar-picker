{
    "name": "matondojk/filament-avatar-picker",
    "description": "A beautiful, highly-customizable avatar gallery and upload picker component for Filament PHP.",
    "type": "filament-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "MatondoJK",
            "email": "matondo@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0|^5.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MatondoJK\\FilamentAvatarPicker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MatondoJK\\FilamentAvatarPicker\\FilamentAvatarPickerServiceProvider"
            ]
        }
    }
}